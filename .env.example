# BookShelf Environment Variables Template

# Clerk Authentication (Use pk_live_... and sk_live_... in Production)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon PostgreSQL Database
# Pooled connection string with pgbouncer for high concurrency
DATABASE_URL=postgresql://user:pass@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# Direct unpooled connection string for migrations
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-host.region.aws.neon.tech/neondb?sslmode=require

# AI Literary Archivist (Recommended: Google Gemini Free Tier at https://aistudio.google.com/app/apikey)
# Supports: GEMINI_API_KEY, OPENAI_API_KEY, or GROQ_API_KEY
# If not provided, dynamic Open Library situational discovery is used automatically!
GEMINI_API_KEY=
OPENAI_API_KEY=
